---
import '../index.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página no encontrada (404) | TerosTec</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#E6E9EE] text-[#0F172A] min-h-screen flex items-center justify-center p-6 antialiased">
    <div class="max-w-md w-full text-center bg-white/70 backdrop-blur-xl border border-black/10 rounded-3xl p-8 sm:p-10 shadow-xl">
      <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-[#0F172A] flex items-center justify-center p-3 shadow-md">
        <img src="/logo-icon-white.png" alt="TerosTec" class="w-10 h-10 object-contain" />
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-[#0F172A] mb-2">404</h1>
      <h2 class="text-lg font-semibold text-[#334155] mb-4">Página no encontrada</h2>
      <p class="text-sm text-[#64748B] mb-8 leading-relaxed">
        La dirección a la que intentas acceder no existe o fue movida.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-semibold bg-[#0F172A] text-white hover:bg-black transition-all shadow-md hover:scale-[1.02]"
      >
        Volver al inicio
      </a>
    </div>
  </body>
</html>
