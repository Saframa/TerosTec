---
import Page from '../layouts/Page.astro';
---

<Page title="Página no encontrada | TerosTec" description="La página que buscas no existe o cambió de dirección." noindex>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24">
    <h1 class="display-title text-4xl sm:text-5xl font-extrabold text-[#0F172A] tracking-tight">Página no encontrada</h1>
    <p class="mt-6 text-lg text-[#475569] leading-relaxed">La página que buscas no existe o cambió de dirección.</p>
    <a
      href="/"
      class="apple-button mt-8 inline-flex items-center px-7 py-3.5 rounded-full text-sm font-semibold bg-[#0F172A] text-white hover:bg-black shadow-md"
    >
      Volver al inicio
    </a>
  </div>
</Page>
