---
import { createElement } from 'react';
import { renderToString } from 'react-dom/server';
import App from '../App';
import type { Language } from '../i18n/translations';
import { siteConfig } from '../config/site';
import '../index.css';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const SITE = 'https://terostec.netlify.app';
const urls: Record<Language, string> = { es: `${SITE}/`, en: `${SITE}/en/` };

const meta = {
  es: {
    title: 'TerosTec | Software Boutique & Soluciones Digitales',
    description:
      'Desarrollo de software boutique, sistemas a medida, automatizaciones y plataformas web de alto impacto en Montevideo y con alcance global.',
    keywords:
      'software boutique, desarrollo a medida, plataformas web, automatizaciones n8n, bots whatsapp, ingeniería de software, uruguay, montevideo',
    locale: 'es_UY',
    altLocale: 'en_US',
  },
  en: {
    title: 'TerosTec | Boutique Software & Digital Solutions',
    description:
      'Boutique software development: custom systems, process automation and high-impact web platforms, built in Montevideo with global reach.',
    keywords:
      'boutique software, custom development, web platforms, n8n automation, whatsapp bots, software engineering, uruguay, montevideo',
    locale: 'en_US',
    altLocale: 'es_UY',
  },
}[lang];

// La app completa se prerenderiza a HTML (indexable sin ejecutar JS) y luego
// src/client/hydrate.tsx la hidrata. renderToString (no las islas de Astro)
// evita scripts inline y mantiene la CSP estricta de netlify.toml.
const appHtml = renderToString(createElement(App, { initialLanguage: lang }));

const team = siteConfig.team;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'TerosTec',
      alternateName: ['TerosTec Software Boutique', 'TerosTec Uruguay'],
      url: `${SITE}/`,
      inLanguage: ['es-UY', 'en-US'],
      description: 'Desarrollo de software boutique, sistemas a medida y automatizaciones de procesos.',
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#organization`,
      name: 'TerosTec',
      url: `${SITE}/`,
      logo: { '@type': 'ImageObject', url: `${SITE}/favicon.svg`, width: 64, height: 64 },
      image: `${SITE}/og-image.png`,
      email: siteConfig.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Montevideo', addressCountry: 'UY' },
      areaServed: [
        { '@type': 'Country', name: 'Uruguay' },
        { '@type': 'AdministrativeArea', name: 'Global' },
      ],
      founder: team.map((m) => ({
        '@type': 'Person',
        name: m.name,
        jobTitle: m.role,
        ...(m.image ? { image: `${SITE}${m.image}` } : {}),
        ...(m.linkedinUrl ? { sameAs: m.linkedinUrl } : {}),
      })),
      sameAs: [
        'https://github.com/Saframa/TerosTec',
        ...team.filter((m) => m.linkedinUrl).map((m) => m.linkedinUrl),
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Soluciones de Software',
        itemListElement: [
          ['Presencia Web & Alta Conversión', 'Landing pages, cotizadores interactivos y sistemas de reservas.'],
          ['Comercio & Operaciones B2B', 'Tiendas online, catálogos B2B mayoristas y portales de clientes.'],
          ['Automatizaciones & Bots', 'Bots de WhatsApp automatizados e integraciones de APIs con n8n y Make.'],
          ['Software a Medida & Sistemas Internos', 'Dashboards BI, control de stock, apps móviles PWA y MVPs completos.'],
        ].map(([name, description]) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name, description },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 1. METADATOS (SEO BÁSICO) -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={urls[lang]} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="TerosTec" />
    <meta name="google-site-verification" content="google10436712f33c97a7" />
    <meta name="keywords" content={meta.keywords} />

    <!-- Versiones por idioma -->
    <link rel="alternate" hreflang="es" href={urls.es} />
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="x-default" href={urls.es} />

    <!-- 2. OPEN GRAPH & TWITTER CARDS -->
    <meta property="og:site_name" content="TerosTec" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={urls[lang]} />
    <meta property="og:image" content={`${SITE}/og-image.png`} />
    <meta property="og:image:secure_url" content={`${SITE}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`TerosTec - ${meta.title.replace('TerosTec | ', '')}`} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:locale:alternate" content={meta.altLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={`${SITE}/og-image.png`} />

    <!-- 3. IDENTIDAD VISUAL (FAVICONS & PWA) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#E6E9EE" />

    <!-- Tipografía: Inter autoalojada -->
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />

    <!-- 4. DATOS ESTRUCTURADOS (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- ESTILOS CRITICOS DEL PRELOADER CON LLENADO DE LOGO -->
    <style is:inline>
      @keyframes logoFillUp {
        0% {
          clip-path: inset(100% 0 0 0);
          -webkit-clip-path: inset(100% 0 0 0);
        }
        100% {
          clip-path: inset(0% 0 0 0);
          -webkit-clip-path: inset(0% 0 0 0);
        }
      }

      body.preloading {
        overflow: hidden !important;
        height: 100vh !important;
        touch-action: none !important;
      }

      #app-preloader {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: #E6E9EE;
        transition: opacity 0.35s ease, visibility 0.35s ease;
      }

      .preloader-emblem-box {
        position: relative;
        width: clamp(86px, 24vw, 136px);
        height: clamp(86px, 24vw, 136px);
      }

      .preloader-fill-layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        clip-path: inset(100% 0 0 0);
        -webkit-clip-path: inset(100% 0 0 0);
        animation: logoFillUp 1.25s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
    </style>
  </head>
  <body class="bg-[#E6E9EE] text-[#0F172A] antialiased selection:bg-neutral-300 selection:text-neutral-900 preloading">
    <!-- PRELOADER CON LLENADO ASCENDENTE DEL LOGO DE LA EMPRESA -->
    <div id="app-preloader">
      <div class="preloader-emblem-box">
        <!-- Silueta tenue de fondo -->
        <img
          src="/logo-icon.png"
          alt="TerosTec"
          width="136"
          height="136"
          style="width: 100%; height: 100%; object-fit: contain; opacity: 0.12; user-select: none; pointer-events: none;"
        />
        <!-- Capa con llenado hacia arriba -->
        <div class="preloader-fill-layer">
          <img
            src="/logo-icon.png"
            alt="TerosTec"
            width="136"
            height="136"
            style="width: 100%; height: 100%; object-fit: contain; user-select: none; pointer-events: none;"
          />
        </div>
      </div>
    </div>

    <!-- APP REACT PRERENDERIZADA (se hidrata en src/client/hydrate.tsx) -->
    <div id="root" set:html={appHtml} />

    <!-- ARRANQUE: purga de insignias de Netlify + ciclo de vida del preloader -->
    <script is:inline src="/boot.js"></script>
    <script>
      import '../client/hydrate';
    </script>
  </body>
</html>
